import Rel.Programs.FrameJoin

/-! The dataframe library (plan M2) at the unbounded number object: positions and values in `obj N`, which declares
    no length, so no row below reads a bound the frame did not bring. The fixture and the hand-worked rows are those
    of `TestFrameCols`/`Pos`/`Group`/`Join`/`Null`, copied. `big` is written inline (as a table, `<°` has no right
    bound at `N`). -/

namespace Rel.Lang.TestFrameUnbounded

open Rel.Programs.prelude Rel.Programs.frame Rel.Programs.frameGroup Rel.Programs.frameJoin in
rel_program frameUnboundedT where
    obj K = {A,B,C}
    obj S = {a,b}
    obj N
    x : N ⟶ K×N ≜ {(0,(B,5)),(1,(A,3)),(2,(B,5)),(3,(C,1)),(4,(A,7)),(5,(C,2)),(6,(B,1)),(7,(A,3))}

    -- plan R1: `(+n)°` as `minus`, `Λ` with its domain written, `F(v) sum`; `v − 1` = 4 2 4 0 6 1 0 2
    test x π₂ ⟨𝟙, ⊤ {(∗,1)}⟩minus = {(0,4),(1,2),(2,4),(3,0),(4,6),(5,1),(6,0),(7,2)}
    test agg((x π₁)°, length) = {(A,3),(B,3),(C,2)}

    -- TestFrameCols
    z : N ⟶ N ≜ {(0,1),(1,2),(2,3)}
    w : N ⟶ 1+N ≜ dom(z) tot({(0,5),(2,3)})
    c : N ⟶ [K] ≜ {(0,A B C),(1,B A),(2,C A B)}
    code : K ⟶ N ≜ {(A,1),(B,2)}
    test x π₁ = {(0,B),(1,A),(2,B),(3,C),(4,A),(5,C),(6,B),(7,A)}
    test x ⟨π₁, π₂ ⟨𝟙,𝟙⟩plus⟩ = {(0,(B,10)),(1,(A,6)),(2,(B,10)),(3,(C,2)),(4,(A,14)),(5,(C,4)),(6,(B,2)),(7,(A,6))}
    test x applyWhere(dom(π₁ {(A,A)}), ⟨π₁, π₂ succ⟩) =
      {(0,(B,5)),(1,(A,4)),(2,(B,5)),(3,(C,1)),(4,(A,8)),(5,(C,2)),(6,(B,1)),(7,(A,4))}
    ix : N ⟶ N ≜ {(0,3),(1,0),(2,3)}
    test ix x = {(0,(C,1)),(1,(B,5)),(2,(C,1))}
    test summarize(F(x π₂) sum, x) = {(∗,27)}
    test count(x) = {(∗,8)}
    -- the integer quotient `sum div length` (`summarize` composes with `div`; not a mean)
    test summarize(F(x π₂) ⟨sum, length⟩div, x) = {(∗,3)}
    test summarize(F(x π₂) Λ(∋) last, x) = {(∗,7)}
    test summarize(F(x π₂) Λ(∋) head, x) = {(∗,1)}
    test summarize(F(x π₁), x) = {(∗,B A B C A C B A)}
    test ⟨x, z⟩ = {(0,((B,5),1)),(1,((A,3),2)),(2,((B,5),3))}
    test hstack(x, z) = 𝟘
    test hstack(take({(∗,3)}, x), z) = {(0,((B,5),1)),(1,((A,3),2)),(2,((B,5),3))}
    test w [{(∗,0)}, 𝟙] = {(0,5),(1,0),(2,3)}
    test x π₁ code = {(0,2),(1,1),(2,2),(4,1),(6,2),(7,1)}
    test x π₁ tot(code) [{(∗,0)}, 𝟙] = {(0,2),(1,1),(2,2),(3,0),(4,1),(5,0),(6,2),(7,1)}
    test over(π₁, F(x π₂) sum, x) = {(0,((B,5),11)),(1,((A,3),13)),(2,((B,5),11)),(3,((C,1),3)),(4,((A,7),13)),
      (5,((C,2),3)),(6,((B,1),11)),(7,((A,3),13))}
    test dom(c contains({(A B,A B)})) = {(0,0),(2,2)}
    cl : N ⟶ N ≜ c length
    test cl = {(0,3),(1,2),(2,3)}
    test summarize(F(x π₂) ⦇[{(∗,0)}, max]⦈, x) = {(∗,7)}
    test x π₂ ⟨𝟙, ⊤ {(∗,2)}⟩div = {(0,2),(1,1),(2,2),(3,0),(4,3),(5,1),(6,0),(7,1)}
    test x π₂ ⟨𝟙, ⊤ {(∗,2)}⟩mod = {(0,1),(1,1),(2,1),(3,1),(4,1),(5,0),(6,1),(7,1)}
    test filterBy(dom(π₁ {(A,A)}) ∩ dom(π₂ dom(<°{(2,∗)})), x) = {(0,(A,3)),(1,(A,7)),(2,(A,3))}
    seven : N ⟶ N ≜ {(7,7)}
    test filterBy(dom(π₁ {(C,C)}) ∪ dom(π₂ seven), x) = {(0,(C,1)),(1,(A,7)),(2,(C,2))}
    test filterBy(𝟙 − dom(π₂ dom(<°{(2,∗)})), x) = {(0,(C,1)),(1,(C,2)),(2,(B,1))}

    -- TestFramePos
    test take({(∗,3)}, x) = {(0,(B,5)),(1,(A,3)),(2,(B,5))}
    test drop({(∗,3)}, x) = {(0,(C,1)),(1,(A,7)),(2,(C,2)),(3,(B,1)),(4,(A,3))}
    test range({(∗,2)}, {(∗,5)}, x) = {(0,(B,5)),(1,(C,1)),(2,(A,7))}
    pz : N ⟶ N ≜ asc(dom(x π₂ dom(<°{(2,∗)})))
    test pz = {(0,0),(1,1),(2,2),(3,4),(4,7)}
    test filterBy(dom(π₂ dom(<°{(2,∗)})), x) = {(0,(B,5)),(1,(A,3)),(2,(B,5)),(3,(A,7)),(4,(A,3))}
    test takeLast({(∗,3)}, x) = {(0,(C,2)),(1,(B,1)),(2,(A,3))}
    test takeLast({(∗,10)}, x) = x
    test dropLast({(∗,3)}, x) = {(0,(B,5)),(1,(A,3)),(2,(B,5)),(3,(C,1)),(4,(A,7))}
    test dropLast({(∗,10)}, x) = 𝟘
    test rolling({(∗,3)}, F(x π₂) sum, x) = {(0,5),(1,8),(2,13),(3,9),(4,13),(5,10),(6,10),(7,6)}
    test cumAgg(F(x π₂) sum, x) = {(0,5),(1,8),(2,13),(3,14),(4,21),(5,23),(6,24),(7,27)}
    test cumAgg(F(x π₂) Λ(∋) last, x) = {(0,5),(1,5),(2,5),(3,5),(4,7),(5,7),(6,7),(7,7)}
    test cumSum(x π₂) = {(0,5),(1,8),(2,13),(3,14),(4,21),(5,23),(6,24),(7,27)}
    test sumsBy(x π₁, x π₂) = {(0,5),(1,3),(2,10),(3,1),(4,10),(5,3),(6,11),(7,13)}
    test firstOrNothing(x π₂) [{(∗,40)}, 𝟙] = {(∗,5)}
    test lastOrNothing(x π₂) [{(∗,40)}, 𝟙] = {(∗,3)}
    test firstOrNothing(take({(∗,0)}, x π₂)) [{(∗,40)}, 𝟙] = {(∗,40)}

    -- TestFrameGroup
    test iasc(x π₁) = {(0,1),(1,4),(2,7),(3,0),(4,2),(5,6),(6,3),(7,5)}
    test idesc(x π₁) = {(0,3),(1,5),(2,0),(3,2),(4,6),(5,1),(6,4),(7,7)}
    test sortBy(π₁, x) = {(0,(A,3)),(1,(A,7)),(2,(A,3)),(3,(B,5)),(4,(B,5)),(5,(B,1)),(6,(C,1)),(7,(C,2))}
    test topBy({(∗,2)}, π₁, x) = {(0,(A,3)),(1,(A,7))}
    test sortByDesc(π₁, x) = {(0,(C,1)),(1,(C,2)),(2,(B,5)),(3,(B,5)),(4,(B,1)),(5,(A,3)),(6,(A,7)),(7,(A,3))}
    test topK({(∗,3)}, π₂, x) = {(0,(A,7)),(1,(B,5)),(2,(B,5))}
    test firstOcc(x π₁) = {(0,0),(1,1),(2,3)}
    test group(x π₁)° = {(0,0),(1,1),(2,0),(3,2),(4,1),(5,2),(6,0),(7,1)}
    test lastOcc(x π₁) = {(0,6),(1,7),(2,5)}
    test firstOcc(x) = {(0,0),(1,1),(2,3),(3,4),(4,5),(5,6)}
    test distinct(x) = {(0,(B,5)),(1,(A,3)),(2,(C,1)),(3,(A,7)),(4,(C,2)),(5,(B,1))}
    test aggregate(π₁, F(x π₂) sum, x) = {(0,(B,11)),(1,(A,13)),(2,(C,3))}
    test aggregate(π₁, F(x π₂) Λ(∋) last, x) = {(0,(B,5)),(1,(A,7)),(2,(C,2))}
    test aggregate(π₁, F(x π₂) Λ(∋) head, x) = {(0,(B,1)),(1,(A,3)),(2,(C,1))}
    ag3 : N ⟶ K×(N×(N×N)) ≜ aggregate(π₁, ⟨F(x π₂) sum, ⟨length, F(x π₂) Λ(∋) last⟩⟩, x)
    test ag3 = {(0,(B,(11,(3,5)))),(1,(A,(13,(3,7)))),(2,(C,(3,(2,2))))}
    vc2 : N ⟶ (K×N)×N ≜ aggregate(⟨π₁, π₂⟩, length, x)
    test vc2 = {(0,((B,5),2)),(1,((A,3),2)),(2,((C,1),1)),(3,((A,7),1)),(4,((C,2),1)),
      (5,((B,1),1))}
    test iasc(x ⟨π₂, π₁⟩) = {(0,6),(1,3),(2,5),(3,1),(4,7),(5,0),(6,2),(7,4)}
    test sortByDesc(⟨π₂, π₁⟩, x) = {(0,(A,7)),(1,(B,5)),(2,(B,5)),(3,(A,3)),(4,(A,3)),(5,(C,2)),(6,(C,1)),(7,(B,1))}
    vc : N ⟶ K×N ≜ valueCounts(π₁, x)
    test vc = {(0,(B,3)),(1,(A,3)),(2,(C,2))}
    test collect(π₁, π₂, x) = {(0,(B,5 5 1)),(1,(A,3 7 3)),(2,(C,1 2))}
    test aggregate(π₁, F(x π₂) head, x) = {(0,(B,5)),(1,(A,3)),(2,(C,1))}
    test aggregate(π₁, F(x π₂) last, x) = {(0,(B,1)),(1,(A,3)),(2,(C,2))}
    test countDistinct(x π₁) = {(∗,3)}
    test countDistinct(x π₂) = {(∗,5)}
    test countDistinct(x) = {(∗,6)}
    test mode(π₁, x) = {(∗,B)}
    test mode(π₂, x) = {(∗,5)}

    -- TestFrameJoin
    y : N ⟶ K×N ≜ {(0,(A,9)),(1,(C,8)),(2,(A,6))}
    y2 : N ⟶ K×N ≜ {(0,(A,3)),(1,(C,2)),(2,(B,4))}
    wj : N ⟶ N×N ≜ {(0,(1,2)),(1,(3,4)),(2,(5,6))}
    test J(π₁, π₁, x, y) = {(1,0),(1,2),(3,1),(4,0),(4,2),(5,1),(7,0),(7,2)}
    y3 : N ⟶ K×(N×N) ≜ {(0,(A,(3,11))),(1,(B,(5,12))),(2,(A,(7,13))),(3,(B,(1,14)))}
    ij2 : N ⟶ (K×N)×(K×(N×N)) ≜ innerJoin(⟨π₁, π₂⟩, ⟨π₁, π₂ π₁⟩, x, y3)
    test ij2 = {(0,((B,5),(B,(5,12)))),(1,((A,3),(A,(3,11)))),(2,((B,5),(B,(5,12)))),(3,((A,7),(A,(7,13)))),
      (4,((B,1),(B,(1,14)))),(5,((A,3),(A,(3,11))))}
    test semiJoin(π₁, π₁, x, y) = {(0,(A,3)),(1,(C,1)),(2,(A,7)),(3,(C,2)),(4,(A,3))}
    test antiJoin(π₁, π₁, x, y) = {(0,(B,5)),(1,(B,5)),(2,(B,1))}
    test innerJoin(π₁, π₁, x, y) = {(0,((A,3),(A,9))),(1,((A,3),(A,6))),(2,((C,1),(C,8))),(3,((A,7),(A,9))),
      (4,((A,7),(A,6))),(5,((C,2),(C,8))),(6,((A,3),(A,9))),(7,((A,3),(A,6)))}
    cj : N ⟶ N×N ≜ crossJoin(dom(x), dom(y))
    test cj = {(0,(0,0)),(1,(0,1)),(2,(0,2)),(3,(1,0)),(4,(1,1)),(5,(1,2)),(6,(2,0)),(7,(2,1)),(8,(2,2)),
      (9,(3,0)),(10,(3,1)),(11,(3,2)),(12,(4,0)),(13,(4,1)),(14,(4,2)),(15,(5,0)),(16,(5,1)),(17,(5,2)),
      (18,(6,0)),(19,(6,1)),(20,(6,2)),(21,(7,0)),(22,(7,1)),(23,(7,2))}
    test append(x, y) = {(0,(B,5)),(1,(A,3)),(2,(B,5)),(3,(C,1)),(4,(A,7)),(5,(C,2)),(6,(B,1)),(7,(A,3)),
      (8,(A,9)),(9,(C,8)),(10,(A,6))}
    test union(x, y) = {(0,(B,5)),(1,(A,3)),(2,(C,1)),(3,(A,7)),(4,(C,2)),(5,(B,1)),(6,(A,9)),(7,(C,8)),(8,(A,6))}
    test intersect(x, y2) = {(0,(A,3)),(1,(C,2))}
    test difference(x, y2) = {(0,(B,5)),(1,(C,1)),(2,(A,7)),(3,(B,1))}
    test symmetricDifference(x, y2) = {(0,(B,5)),(1,(C,1)),(2,(A,7)),(3,(B,1)),(4,(B,4))}
    test melt({(∗,a)}, π₁, {(∗,b)}, π₂, wj) = {(0,(a,1)),(1,(a,3)),(2,(a,5)),(3,(b,2)),(4,(b,4)),(5,(b,6))}
    t : N ⟶ K×(N×N) ≜ {(0,(A,(1,2))),(1,(B,(3,4))),(2,(C,(5,6)))}
    test pivotLong(π₁, {(∗,a)}, π₂ π₁, {(∗,b)}, π₂ π₂, t) =
      {(0,(A,(a,1))),(1,(B,(a,3))),(2,(C,(a,5))),(3,(A,(b,2))),(4,(B,(b,4))),(5,(C,(b,6)))}

    -- TestFrameNull
    yl : N ⟶ K×N ≜ {(0,(A,9)),(1,(C,8))}
    lj : N ⟶ (K×N)×(K×N) ≜ leftJoin(π₁, π₁, x, yl) ⟨π₁, π₂ [{(∗,(B,0))}, 𝟙]⟩
    test lj = {(0,((B,5),(B,0))),(1,((A,3),(A,9))),(2,((B,5),(B,0))),(3,((C,1),(C,8))),(4,((A,7),(A,9))),
      (5,((C,2),(C,8))),(6,((B,1),(B,0))),(7,((A,3),(A,9)))}
    rj : N ⟶ (K×N)×(K×N) ≜ rightJoin(π₁, π₁, yl, x) ⟨π₁ [{(∗,(B,0))}, 𝟙], π₂⟩
    test rj = {(0,((B,0),(B,5))),(1,((A,9),(A,3))),(2,((B,0),(B,5))),(3,((C,8),(C,1))),(4,((A,9),(A,7))),
      (5,((C,8),(C,2))),(6,((B,0),(B,1))),(7,((A,9),(A,3)))}
    fj : N ⟶ (K×N)×(K×N) ≜ fullOuterJoin(π₁, π₁, yl, x) ⟨π₁ [{(∗,(B,0))}, 𝟙], π₂ [{(∗,(B,0))}, 𝟙]⟩
    test fj = {(0,((A,9),(A,3))),(1,((A,9),(A,7))),(2,((A,9),(A,3))),(3,((C,8),(C,1))),(4,((C,8),(C,2))),
      (5,((B,0),(B,5))),(6,((B,0),(B,5))),(7,((B,0),(B,1)))}
    nc : N ⟶ 1+N ≜ dom(x) tot({(0,5),(2,5),(4,7),(7,3)})
    xn : N ⟶ K×(1+N) ≜ ⟨x π₁, nc⟩
    test filterJust(π₂, xn) ⟨π₁, π₂ inr°⟩ = {(0,(B,5)),(1,(B,5)),(2,(A,7)),(3,(A,3))}
    test filterNothing(π₂, xn) π₁ = {(0,A),(1,C),(2,C),(3,B)}
    test shift({(∗,1)}, x π₂) [{(∗,40)}, 𝟙] = {(0,40),(1,5),(2,3),(3,5),(4,1),(5,7),(6,2),(7,1)}
    test shift({(∗,2)}, x π₂) [{(∗,40)}, 𝟙] = {(0,40),(1,40),(2,5),(3,3),(4,5),(5,1),(6,7),(7,2)}
    test next({(∗,1)}, x π₂) [{(∗,40)}, 𝟙] = {(0,3),(1,5),(2,1),(3,7),(4,2),(5,1),(6,3),(7,40)}
    test next({(∗,2)}, x π₂) [{(∗,40)}, 𝟙] = {(0,5),(1,1),(2,7),(3,2),(4,1),(5,3),(6,40),(7,40)}
    -- `N` holds the negatives `Z = -10…40` held in `TestFrameNull`
    v : N ⟶ N ≜ {(0,5),(1,3),(2,5),(3,1),(4,7),(5,2),(6,1),(7,3)}
    test diff({(∗,1)}, v) [{(∗,40)}, 𝟙] = {(0,40),(1,-2),(2,2),(3,-4),(4,6),(5,-5),(6,-1),(7,2)}
    test x π₂ inr [{(∗,40)}, 𝟙] = x π₂
    test nc inr° = {(0,5),(2,5),(4,7),(7,3)}
    test dom(nc inr°) = {(0,0),(2,2),(4,4),(7,7)}
    test dom(nc inl°) = {(1,1),(3,3),(5,5),(6,6)}
    test nc (𝟙 ⊕ succ) [{(∗,40)}, 𝟙] = {(0,6),(1,40),(2,6),(3,40),(4,8),(5,40),(6,40),(7,4)}
    -- impute with the integer quotient `sum div length` of the valued rows (not a mean): 20 div 4 = 5
    test nc [summarize(F(nc inr°) ⟨sum, length⟩div, nc inr°), 𝟙] = {(0,5),(1,5),(2,5),(3,5),(4,7),(5,5),(6,5),(7,3)}
    test nulls(π₂, xn) = {(∗,4)}
    test fills(nc) [{(∗,40)}, 𝟙] = {(0,5),(1,5),(2,5),(3,5),(4,7),(5,7),(6,7),(7,3)}
    n2 : N ⟶ 1+N ≜ dom(x) tot({(2,4),(5,1)})
    test fills(n2) [{(∗,40)}, 𝟙] = {(0,40),(1,40),(2,4),(3,4),(4,4),(5,1),(6,1),(7,1)}
    test v ⟨𝟙, ⊤ {(∗,3)}⟩minus ⟨𝟙, ⊤ {(∗,0)}⟩max = {(0,2),(1,0),(2,2),(3,0),(4,4),(5,0),(6,0),(7,0)}
    q : N ⟶ K×N ≜ {(0,(A,2)),(1,(A,6)),(2,(C,1)),(3,(B,9))}
    aq : N ⟶ (K×N)×(K×N) ≜ aj(π₁, π₂, π₁, π₂, x, q) ⟨π₁, π₂ [{(∗,(B,0))}, 𝟙]⟩
    test aq = {(0,((B,5),(B,0))),(1,((A,3),(A,2))),(2,((B,5),(B,0))),(3,((C,1),(C,1))),(4,((A,7),(A,6))),
      (5,((C,2),(C,1))),(6,((B,1),(B,0))),(7,((A,3),(A,2)))}
    qt : N ⟶ K×(N×N) ≜ {(0,(A,(2,10))),(1,(C,(1,11))),(2,(A,(2,12))),(3,(A,(6,13))),(4,(C,(1,14))),(5,(C,(3,15)))}
    test aj(π₁, π₂, π₁, π₂ π₁, x, qt) ⟨π₁, π₂ [{(∗,0)}, π₂ π₂]⟩ = {(0,((B,5),0)),(1,((A,3),12)),(2,((B,5),0)),
      (3,((C,1),14)),(4,((A,7),13)),(5,((C,2),14)),(6,((B,1),0)),(7,((A,3),12))}
    t3 : N ⟶ K×(S×N) ≜ {(0,(A,(a,1))),(1,(B,(a,2))),(2,(A,(b,3))),(3,(A,(a,4))),(4,(C,(b,5)))}
    pw : N ⟶ K×(N×N) ≜ pivotWide(π₁, π₂ π₁, {(∗,a)}, {(∗,b)}, F(t3 π₂ π₂) sum, t3) ⟨π₁, ⟨π₂ π₁ [{(∗,0)}, 𝟙], π₂ π₂ [{(∗,0)}, 𝟙]⟩⟩
    test pw = {(0,(A,(5,3))),(1,(B,(2,0))),(2,(C,(0,5)))}

    -- a top-level `asc` of a closed set: `j ↦` its `j`-th smallest element
    s : N ⟶ N ≜ {(9,9),(2,2),(5,5)}
    sa : N ⟶ N ≜ asc(s)
    test sa = {(0,2),(1,5),(2,9)}



-- describe `v` (`frameStat`, a program of its own as in `TestFrameCols`): count 8, mean 27/8 = 3.375, min 1, max 7;
-- sample std √(255/56) ≈ 2.1339 is no float, pinned in (2.125, 2.25): 2.125² = 4.515625 < 255/56 < 5.0625 = 2.25²
open Rel.Programs.prelude Rel.Programs.frame Rel.Programs.frameStat in
rel_program frameDescribeU where
    obj K = {A,B,C}
    obj N
    obj F : f64
    x : N ⟶ K×N ≜ {(0,(B,5)),(1,(A,3)),(2,(B,5)),(3,(C,1)),(4,(A,7)),(5,(C,2)),(6,(B,1)),(7,(A,3))}
    test describe(x π₂) ⟨π₁, ⟨π₂ π₁, π₂ π₂ π₂⟩⟩ = {(∗,(8,(3.375,(1,7))))}
    test describe(x π₂) π₂ π₂ π₁ [{(∗,-1.0)}, 𝟙] <° {(2.125,∗)} = {(∗,∗)}
    test describe(x π₂) π₂ π₂ π₁ [{(∗,-1.0)}, 𝟙] < {(2.25,∗)} = {(∗,∗)}



end Rel.Lang.TestFrameUnbounded
